# Miscellaneous
.*
!.github/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
*.jks
*.keystore

# XCode related
macos/Runner.xcodeproj/xcuserdata/
macos/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/xcuserdata/
ios/Runner.xcworkspace/xcuserdata/
macos/Runner/Configs/LocalSigning.xcconfig
ios/Flutter/LocalSigning.xcconfig

# Environment files 
.env
.env.local
.env.*.local

# Secrets
*.pem
*.key
secrets/

# Live captures from tool/capture_status_fixtures.dart. Redacted, but not
# committed: they are the user's own instance data. The glob is deliberately
# wide so Syncthing conflict copies (queue.captured.sync-conflict-*.json)
# are caught too.
test/fixtures/**/*.captured*

# Local planning and design notes.
*_plan.md
PRODUCT.md
DESIGN.md

# Golden-test output. `matchesGoldenFile` writes the four
# master/test/isolatedDiff/maskedDiff PNGs here on every failure; they are a
# local debugging aid, never a repo artifact.
test/failures/

# Coverage reports (`flutter test --coverage`).
coverage/

# Syncthing conflict copies (the repo is inside a synced folder).
*sync-conflict-*

